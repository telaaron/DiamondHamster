//@version=6
indicator("Harms BTC - QS-Klassen je Zyklus (1D)", shorttitle="BTC QS Zyklen", overlay=false, precision=0, max_labels_count=500)

// Eigenstaendiger Kalenderindikator. Bestehende RSI-/HSMM-Indikatoren bleiben unveraendert.
// Anwendung: Bitcoin-Chart auf 1D; moeglichst derselbe Indexfeed wie bei den Ankern.
// Klasse A / Klasse B: 2011 = 4/6, 2015 = 6/3, 2018 = 3/5, 2022 = 5/9.
// Anker = Tag 0, ohne QS-Treffer. Der folgende Kalendertag ist Tag 1.
// Zyklusintervalle: [Anker, naechster Anker). Der neue Anker gehoert dem neuen Zyklus.
// Kalenderdatum der Bar-Eröffnung in UTC, keine Zaehlung von vorhandenen Bars.
// Historische Treffer verwenden plotshape: kein Abschneiden auf die letzten 500 Labels.
// Zukunft: ausschliesslich Kalenderfortschreibung im QS-Fenster, kein Preisziel.
// Es wird nur die iterierte QS der vergangenen Tage berechnet, keine Datums-QS.
// Die letzte, eventuell offene Tageskerze ist enthalten: ihre QS steht bereits fest.
// Sichtbar sind nur Tage, fuer die der Chartanbieter Kerzen bereitstellt, plus die Projektion.

const int DAY_MS = 86400000
const string G_ANCHOR = "Zyklusanker"
const string G_VIEW = "Darstellung"
const string G_FUTURE = "Letzter Zyklus: Kalenderfortschreibung"

string anchor2015Choice = input.string("18.08.2015", "Bärenmarktanker 2015", options=["18.08.2015", "14.01.2015"], group=G_ANCHOR, tooltip="Standard gemäß deiner Tabelle: 18.08.2015. Die Alternative liegt 216 Tage früher und besitzt daher dieselbe relative Modulo-9-Phase nach dem Augustanker.")
bool showPriceMarks = input.bool(true, "QS-Treffer zusätzlich unter den Kurskerzen", group=G_VIEW)
bool showBackground = input.bool(false, "Treffertage im QS-Fenster hinterlegen", group=G_VIEW)
bool showAnchors = input.bool(true, "Bärenmarktanker markieren", group=G_VIEW)
bool showInfo = input.bool(true, "Legende und aktuelle Tageswerte", group=G_VIEW)
color colorA = input.color(#00A6A6, "Klasse A: obere Reihe", group=G_VIEW)
color colorB = input.color(#9758D8, "Klasse B: untere Reihe", group=G_VIEW)
bool showFuture = input.bool(true, "Zukünftige QS-Tage im QS-Fenster anzeigen", group=G_FUTURE, tooltip="Nur im letzten Zyklus. Markiert bekannte Kalenderklassen, keine erwarteten Kursereignisse. Zum Anzeigen rechts Platz im Chart schaffen.")
int futureDays = input.int(500, "Weitere Kalendertage", minval=1, maxval=500, group=G_FUTURE)

int anchor2011 = timestamp("UTC", 2011, 11, 17, 0, 0)
int anchor2015 = anchor2015Choice == "18.08.2015" ? timestamp("UTC", 2015, 8, 18, 0, 0) : timestamp("UTC", 2015, 1, 14, 0, 0)
int anchor2018 = timestamp("UTC", 2018, 12, 15, 0, 0)
int anchor2022 = timestamp("UTC", 2022, 11, 21, 0, 0)

f_qs(int n) =>
    n > 0 ? 1 + ((n - 1) % 9) : 0

f_days(int dayStamp, int anchorStamp) =>
    int((dayStamp - anchorStamp) / DAY_MS)

f_cycle(int dayStamp, int a1, int a2, int a3, int a4) =>
    int result = 0
    if dayStamp >= a4
        result := 4
    else if dayStamp >= a3
        result := 3
    else if dayStamp >= a2
        result := 2
    else if dayStamp >= a1
        result := 1
    result

f_date(int stamp) =>
    str.format_time(stamp, "dd.MM.yyyy", "UTC")

if not (timeframe.isdaily and timeframe.multiplier == 1)
    runtime.error("Bitte diesen QS-Indikator im 1D-Tageschart verwenden.")

int dayUtc = timestamp("UTC", year(time, "UTC"), month(time, "UTC"), dayofmonth(time, "UTC"), 0, 0)
int cycle = f_cycle(dayUtc, anchor2011, anchor2015, anchor2018, anchor2022)
int activeAnchor = cycle == 4 ? anchor2022 : cycle == 3 ? anchor2018 : cycle == 2 ? anchor2015 : cycle == 1 ? anchor2011 : na
int daysFromAnchor = cycle > 0 ? f_days(dayUtc, activeAnchor) : na
int qs = cycle > 0 ? f_qs(daysFromAnchor) : na
int classA = cycle == 1 ? 4 : cycle == 2 ? 6 : cycle == 3 ? 3 : cycle == 4 ? 5 : na
int classB = cycle == 1 ? 6 : cycle == 2 ? 3 : cycle == 3 ? 5 : cycle == 4 ? 9 : na
bool hitA = cycle > 0 and daysFromAnchor > 0 and qs == classA
bool hitB = cycle > 0 and daysFromAnchor > 0 and qs == classB
bool atAnchor = cycle > 0 and daysFromAnchor == 0

// Zwei Reihen erleichtern den Vergleich derselben Klassenrolle ueber alle Zyklen.
hline(2.0, "Klasse A", color=color.new(colorA, 65), linestyle=hline.style_dotted)
hline(1.0, "Klasse B", color=color.new(colorB, 65), linestyle=hline.style_dotted)
hline(0.2, "Anker", color=color.new(color.gray, 85))
hline(2.8, "Oberer Abstand", color=color.new(color.gray, 100))

plotshape(cycle == 1 and hitA ? 2.0 : na, title="2011 - QS 4", style=shape.circle, location=location.absolute, color=colorA, text="4", textcolor=colorA, size=size.tiny)
plotshape(cycle == 1 and hitB ? 1.0 : na, title="2011 - QS 6", style=shape.circle, location=location.absolute, color=colorB, text="6", textcolor=colorB, size=size.tiny)
plotshape(cycle == 2 and hitA ? 2.0 : na, title="2015 - QS 6", style=shape.circle, location=location.absolute, color=colorA, text="6", textcolor=colorA, size=size.tiny)
plotshape(cycle == 2 and hitB ? 1.0 : na, title="2015 - QS 3", style=shape.circle, location=location.absolute, color=colorB, text="3", textcolor=colorB, size=size.tiny)
plotshape(cycle == 3 and hitA ? 2.0 : na, title="2018 - QS 3", style=shape.circle, location=location.absolute, color=colorA, text="3", textcolor=colorA, size=size.tiny)
plotshape(cycle == 3 and hitB ? 1.0 : na, title="2018 - QS 5", style=shape.circle, location=location.absolute, color=colorB, text="5", textcolor=colorB, size=size.tiny)
plotshape(cycle == 4 and hitA ? 2.0 : na, title="2022 - QS 5", style=shape.circle, location=location.absolute, color=colorA, text="5", textcolor=colorA, size=size.tiny)
plotshape(cycle == 4 and hitB ? 1.0 : na, title="2022 - QS 9", style=shape.circle, location=location.absolute, color=colorB, text="9", textcolor=colorB, size=size.tiny)

// Optionale, gleichfarbige Markierungen im Hauptchart. Keine Aenderung der Kurskerzen.
plotshape(showPriceMarks and cycle == 1 and hitA, title="Kurschart 2011 - QS 4", style=shape.circle, location=location.belowbar, color=colorA, text="4", textcolor=colorA, size=size.tiny, force_overlay=true)
plotshape(showPriceMarks and cycle == 1 and hitB, title="Kurschart 2011 - QS 6", style=shape.circle, location=location.belowbar, color=colorB, text="6", textcolor=colorB, size=size.tiny, force_overlay=true)
plotshape(showPriceMarks and cycle == 2 and hitA, title="Kurschart 2015 - QS 6", style=shape.circle, location=location.belowbar, color=colorA, text="6", textcolor=colorA, size=size.tiny, force_overlay=true)
plotshape(showPriceMarks and cycle == 2 and hitB, title="Kurschart 2015 - QS 3", style=shape.circle, location=location.belowbar, color=colorB, text="3", textcolor=colorB, size=size.tiny, force_overlay=true)
plotshape(showPriceMarks and cycle == 3 and hitA, title="Kurschart 2018 - QS 3", style=shape.circle, location=location.belowbar, color=colorA, text="3", textcolor=colorA, size=size.tiny, force_overlay=true)
plotshape(showPriceMarks and cycle == 3 and hitB, title="Kurschart 2018 - QS 5", style=shape.circle, location=location.belowbar, color=colorB, text="5", textcolor=colorB, size=size.tiny, force_overlay=true)
plotshape(showPriceMarks and cycle == 4 and hitA, title="Kurschart 2022 - QS 5", style=shape.circle, location=location.belowbar, color=colorA, text="5", textcolor=colorA, size=size.tiny, force_overlay=true)
plotshape(showPriceMarks and cycle == 4 and hitB, title="Kurschart 2022 - QS 9", style=shape.circle, location=location.belowbar, color=colorB, text="9", textcolor=colorB, size=size.tiny, force_overlay=true)

plotshape(showAnchors and atAnchor ? 0.2 : na, title="Bärenmarktanker - Tag 0", style=shape.diamond, location=location.absolute, color=color.orange, text="0", textcolor=color.orange, size=size.small)

bgcolor(showBackground and hitA ? color.new(colorA, 88) : showBackground and hitB ? color.new(colorB, 88) : na, title="QS-Treffertag")

// Exakte Werte am Fadenkreuz im Datenfenster; keine Auswirkung auf die Pane-Skala.
plot(cycle > 0 ? cycle : na, "Zyklusnummer (1=2011, 2=2015, 3=2018, 4=2022)", display=display.data_window)
plot(daysFromAnchor, "Kalendertage seit Bärenmarktanker", display=display.data_window)
plot(qs, "Iterierte QS des Tagesabstands (0 am Anker)", display=display.data_window)
plot(classA, "Zielklasse A", display=display.data_window)
plot(classB, "Zielklasse B", display=display.data_window)
plot(cycle > 0 ? (hitA or hitB ? 1 : 0) : na, "QS-Treffer (1=ja, 0=nein)", display=display.data_window)

// Zukunftslabels werden ausschliesslich an der letzten Kerze aufgebaut und ersetzt.
// Selbst bei 500 Tagen entstehen fuer zwei Klassen hoechstens 112 Labels.
var array<label> futureLabels = array.new<label>()
if barstate.islast
    while array.size(futureLabels) > 0
        label.delete(array.pop(futureLabels))
    if showFuture and cycle == 4
        for step = 1 to futureDays
            int futureStamp = dayUtc + step * DAY_MS
            int futureAge = f_days(futureStamp, anchor2022)
            int futureQs = f_qs(futureAge)
            if futureQs == 5 or futureQs == 9
                float lane = futureQs == 5 ? 2.0 : 1.0
                color markerColor = futureQs == 5 ? colorA : colorB
                string tip = "Kalenderfortschreibung, keine Kursprognose\n" + f_date(futureStamp) + " UTC\n" + str.tostring(futureAge) + " Tage seit 21.11.2022\nIterierte QS: " + str.tostring(futureQs)
                label marker = label.new(x=futureStamp, y=lane, text=str.tostring(futureQs), xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_center, color=color.new(markerColor, 20), textcolor=color.white, size=size.tiny, tooltip=tip)
                array.push(futureLabels, marker)

// Kleine Legende: Paarung je Zyklus und Werte der letzten Tageskerze.
var table info = table.new(position.top_right, 3, 9, border_width=1)
if barstate.islast
    table.clear(info, 0, 0, 2, 8)
    if showInfo
        color panel = color.new(color.black, 15)
        color heading = color.new(color.gray, 55)
        table.cell(info, 0, 0, "Zyklus", bgcolor=heading, text_color=color.white, text_size=size.small)
        table.cell(info, 1, 0, "Anker UTC", bgcolor=heading, text_color=color.white, text_size=size.small)
        table.cell(info, 2, 0, "QS A / B", bgcolor=heading, text_color=color.white, text_size=size.small)
        table.cell(info, 0, 1, "2011", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 1, 1, "17.11.2011", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 2, 1, "4 / 6", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 0, 2, "2015", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 1, 2, anchor2015Choice, bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 2, 2, "6 / 3", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 0, 3, "2018", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 1, 3, "15.12.2018", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 2, 3, "3 / 5", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 0, 4, "2022", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 1, 4, "21.11.2022", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 2, 4, "5 / 9", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 0, 5, "Letzte Kerze", bgcolor=heading, text_color=color.white, text_size=size.small)
        table.cell(info, 1, 5, f_date(dayUtc), bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 2, 5, cycle > 0 ? "Zyklus " + str.tostring(cycle) : "vor Anker", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 0, 6, "Tage / QS", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 1, 6, cycle > 0 ? str.tostring(daysFromAnchor) + " / " + str.tostring(qs) : "—", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 2, 6, atAnchor ? "Tag 0" : hitA ? "Klasse A" : hitB ? "Klasse B" : "kein Treffer", bgcolor=panel, text_color=hitA ? colorA : hitB ? colorB : color.white, text_size=size.small)
        table.cell(info, 0, 7, "Reihen", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 1, 7, "Oben: A", bgcolor=panel, text_color=colorA, text_size=size.small)
        table.cell(info, 2, 7, "Unten: B", bgcolor=panel, text_color=colorB, text_size=size.small)
        table.cell(info, 0, 8, "Kalender", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 1, 8, showFuture and cycle == 4 ? "+" + str.tostring(futureDays) + " Tage" : "bis letzte Kerze", bgcolor=panel, text_color=color.white, text_size=size.small)
        table.cell(info, 2, 8, showFuture and cycle == 4 ? "bis " + f_date(dayUtc + futureDays * DAY_MS) : "1D / UTC", bgcolor=panel, text_color=color.white, text_size=size.small)

// Ein Alarm ist optional; er meldet ausschliesslich die QS-Zeitklasse am Tagesschluss.
alertcondition((hitA or hitB) and barstate.isconfirmed, title="QS-Treffertag bestätigt", message="BTC QS Zyklen: Tagesabstand trifft eine der zwei Klassen des aktiven Zyklus. Details im Datenfenster. Kein Kauf-/Verkaufssignal.")
